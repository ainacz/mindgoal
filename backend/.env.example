# Postgres. Для Supabase — строка из Project Settings → Database → Connection string,
# заменить postgresql:// на postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marshrut
DB_ECHO=false

# Токен бота из @BotFather. Им же подписан initData — без него авторизации нет.
BOT_TOKEN=

# DeepSeek. Можно оставить пустым: тогда приложение работает на заглушке —
# маршруты шаблонные, но проходятся целиком, и платить не за что.
# Как появится ключ — просто вставь его сюда, код менять не нужно.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
